# Copiá este archivo a .env.local y completá los valores.
# Con `npx supabase start`, la URL y la clave publicable aparecen en la salida del comando.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública de la app (para los enlaces de los correos). En local: http://localhost:3000
APP_URL=http://localhost:3000
