# Secretos de la Edge Function process-outbox.
# Local: copiá a supabase/functions/.env y corré `npm run functions:serve`.
# Producción: `npx supabase secrets set --env-file supabase/functions/.env`
# (SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY ya los inyecta Supabase).

RESEND_API_KEY=re_xxx
EMAIL_FROM="RP Backoffice <hola@tu-dominio.com>"
APP_URL=http://localhost:3000
OUTBOX_CRON_SECRET=un-texto-largo-y-aleatorio
